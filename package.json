{
  "name": "@quotidianlabs/emojis-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @quotidianlabs/emojis-website dev",
    "build": "yarn workspace @quotidianlabs/emojis build",
    "build:data": "yarn workspace @quotidianlabs/emojis-data build",
    "build:react": "yarn workspace @quotidianlabs/emojis-react build",
    "build:website": "yarn workspace @quotidianlabs/emojis-website build",
    "check:types": "tsc --project tsconfig.check.json",
    "check:website": "node scripts/website-check.mjs",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "release:gate": "node scripts/release-gate.mjs",
    "test": "jest"
  },
  "devDependencies": {
    "@parcel/packager-ts": "2.16.4",
    "@parcel/transformer-inline-string": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "@parcel/transformer-typescript-types": "2.16.4",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "parcel": "2.16.4",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always"
  },
  "engines": {
    "yarn": ">=1"
  }
}
